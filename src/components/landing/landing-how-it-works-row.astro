---
import { cn } from "@/lib/utils";

interface Props {
  kicker: string;
  title: string;
  description: string;
  flip?: boolean;
  /** Top-align the columns; for rows whose visual grows taller than the copy. */
  alignStart?: boolean;
}

const props = Astro.props;
---

<div
  class={cn(
    "landing-reveal grid gap-6 border-t border-foreground/15 py-12 md:grid-cols-12 md:gap-12 md:py-16",
    props.alignStart ? "items-start" : "items-center",
  )}
>
  <div class={props.flip ? "md:order-2 md:col-span-5" : "md:col-span-5"}>
    <p class="font-mono text-xs tracking-[0.18em] text-primary uppercase">
      {props.kicker}
    </p>
    <h3 class="mt-3 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
      {props.title}
    </h3>
    <p class="mt-3 text-sm text-foreground/70 sm:text-base">
      {props.description}
    </p>
  </div>
  <div class={props.flip ? "md:order-1 md:col-span-7" : "md:col-span-7"}>
    <slot />
  </div>
</div>
