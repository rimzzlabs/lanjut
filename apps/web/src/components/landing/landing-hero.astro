---
import { type Locale, localizePath } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { A } from "@mobily/ts-belt";
import HeadlineWords from "@/components/shared/headline-words.astro";
import {
  DOWNLOAD_PATHNAME,
  EDITOR_PATHNAME,
  TEMPLATE_PATHNAME,
} from "@/lib/routes";
import { DOWNLOAD_LABEL_KEYS } from "./landing-download-labels";
import LandingEditorShot from "./landing-editor-shot.astro";
import { LandingHeroActions } from "./landing-hero-actions";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "landing");
const downloadLabels = A.map(DOWNLOAD_LABEL_KEYS, (item) => ({
  os: item.os,
  label: t(item.key),
}));
---

<section
  class="mx-auto w-11/12 max-w-6xl pt-10 pb-16 text-center md:pt-16 md:pb-20"
>
  <h1
    class="landing-rise mx-auto max-w-5xl text-[clamp(2.75rem,6.6vw,5.5rem)] leading-[0.95] font-extrabold tracking-[-0.035em] text-balance"
    style="--rise: 0"
  >
    <span class="sr-only">{t("srHeading")}</span>{" "}
    <HeadlineWords text={t("heroLead")} />{" "}
    <span class="text-primary">{t("heroAccent")}</span>
  </h1>

  <p
    class="landing-rise mx-auto mt-6 max-w-[58ch] text-base text-balance text-muted-foreground sm:text-lg md:mt-8"
    style="--rise: 1"
  >
    {t("deck")}
  </p>

  <div class="landing-rise mt-8 md:mt-10" style="--rise: 2">
    <LandingHeroActions
      client:idle
      buildHref={localizePath(EDITOR_PATHNAME, locale)}
      buildLabel={t("heroCta")}
      templatesHref={localizePath(TEMPLATE_PATHNAME, locale)}
      templatesLabel={t("heroTemplates")}
      downloadHref={localizePath(DOWNLOAD_PATHNAME, locale)}
      downloadLabels={downloadLabels}
    />
    <p class="mt-4 text-sm text-muted-foreground">{t("noAccount")}</p>
  </div>

  <div class="landing-rise mt-12 md:mt-16" style="--rise: 3">
    <LandingEditorShot locale={locale} />
  </div>
</section>
