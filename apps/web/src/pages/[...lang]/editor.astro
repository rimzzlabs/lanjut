---
import {
  type Locale,
  localeStaticPaths,
  localizePath,
} from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import PlatformAppPage from "@/components/platform/platform-app-page.astro";
import RootLayout from "@/components/shared/root-layout.astro";
import { editorHref } from "@/lib/routes";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const locale = Astro.props.locale;
const pathname = Astro.url.pathname;
const t = getTranslator(locale, "meta");

// This file answers the library and every `/editor/<id>`, so it holds a
// static shell for each. Any id gives the editor's shell.
const documentPathname = localizePath(editorHref("_"), locale);
---

<RootLayout
  locale={locale}
  title={t("editorTitle")}
  description={t("editorDescription")}
>
  <PlatformAppPage
    locale={locale}
    pathname={pathname}
    shells={[
      { pathname, view: "library" },
      { pathname: documentPathname, view: "editor" },
    ]}
  />
</RootLayout>
