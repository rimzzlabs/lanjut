{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions the main window needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-file",
    "os:allow-platform",
    "os:allow-version"
  ]
}
