{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanjut",
  "version": "../../../package.json",
  "identifier": "com.rimzzlabs.lanjut",
  "build": {
    "beforeDevCommand": "pnpm --filter @lanjut/web dev:astro",
    "beforeBuildCommand": "pnpm --filter @lanjut/web build",
    "devUrl": "http://localhost:4321",
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "title": "Lanjut",
        "width": 1280,
        "height": 860,
        "decorations": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": true,
        "shadow": true,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "Lanjut (beta)",
        "url": "/editor",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "useHttpsScheme": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rimzzlabs/lanjut/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QkY2MzNFMTY0MENCRUQKUldUdHkwQVdQbU8vSm9wOURaZ3l5OHFWWmZBRnhlU2MwY09RVDBwaGlZSHo5ZHVDRmRpOXhNZkgK"
    }
  }
}
