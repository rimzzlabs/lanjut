---
import { type Locale, localizePath } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { DONATION_LINKS } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "footer");
const year = new Date().getFullYear();
---

<footer class="border-t border-foreground/15">
  <div
    class="mx-auto grid w-11/12 max-w-5xl gap-8 py-12 md:grid-cols-[1fr_auto] md:items-end"
  >
    <div>
      <a
        href={localizePath("/", locale)}
        class="inline-flex items-center gap-2 font-brand text-lg font-bold tracking-tight"
      >
        <img src="/favicon.svg" alt="" width="22" height="22" class="size-5.5" />
        Lanjut
      </a>
      <p class="mt-3 max-w-sm text-sm text-muted-foreground">{t("tagline")}</p>
    </div>

    <nav
      aria-label={t("ariaLabel")}
      class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground"
    >
      <a
        href={localizePath("/platform", locale)}
        class="transition-colors hover:text-foreground"
      >
        {t("startBuilding")}
      </a>
      <a
        href={localizePath("/platform/template", locale)}
        class="transition-colors hover:text-foreground"
      >
        {t("templates")}
      </a>
      <a
        href="https://github.com/rimzzlabs/lanjut"
        target="_blank"
        rel="noreferrer"
        class="transition-colors hover:text-foreground"
      >
        {t("github")}
      </a>
    </nav>
  </div>

  <div class="border-t border-foreground/10">
    <div
      class="mx-auto flex w-11/12 max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5"
    >
      <p class="font-mono text-xs text-muted-foreground">
        {t("rights", { year })}
      </p>
      <nav
        aria-label={t("supportAriaLabel")}
        class="flex items-center gap-x-4 text-xs text-muted-foreground"
      >
        <span>{t("support")}</span>
        <a
          href={DONATION_LINKS.saweria}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground"
        >
          <img src="/brands/saweria.png" alt="" width="14" height="14" class="size-3.5" />
          Saweria
        </a>
        <a
          href={DONATION_LINKS.sociabuzz}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground"
        >
          <img src="/brands/sociabuzz.png" alt="" width="14" height="14" class="size-3.5" />
          SociaBuzz
        </a>
      </nav>
    </div>
  </div>
</footer>
