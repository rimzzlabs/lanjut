---
import { ArrowRightIcon, MagnifyingGlassIcon } from "@phosphor-icons/react";
import { buttonVariants } from "@/components/ui/button";
import { type Locale, localizePath } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { cn } from "@/lib/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "hero");

const STATS = [
  { valueKey: "stat1Value", labelKey: "stat1Label" },
  { valueKey: "stat2Value", labelKey: "stat2Label" },
  { valueKey: "stat3Value", labelKey: "stat3Label" },
];
---

<section
  class="mx-auto flex min-h-[calc(100svh-3.5rem)] w-11/12 max-w-5xl flex-col justify-center py-20 md:py-28"
>
  <p
    class="landing-rise flex items-center gap-3 text-xs font-medium tracking-[0.2em] text-muted-foreground uppercase"
    style="--rise: 0"
  >
    <span aria-hidden="true" class="h-px w-8 bg-primary"></span>
    {t("badge")}
  </p>

  <h1
    class="landing-rise mt-6 max-w-4xl font-display text-[clamp(2.5rem,7vw,5.25rem)] leading-[1.02] font-semibold tracking-tight text-balance wrap-anywhere"
    style="--rise: 1"
  >
    <span class="sr-only">{t("srHeading")}</span>
    {t("headingLine1")}
    <br />
    <span class="text-primary">{t("headingLine2")}</span>
  </h1>

  <p
    class="landing-rise mt-7 max-w-2xl text-base text-foreground/70 sm:text-lg"
    style="--rise: 2"
  >
    {t("description")}
  </p>

  <div
    class="landing-rise mt-9 flex w-full max-w-xs flex-col gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:items-center sm:gap-4"
    style="--rise: 3"
  >
    <a
      href={localizePath("/platform", locale)}
      class={cn(buttonVariants({ size: "lg", className: "gap-2" }))}
    >
      {t("ctaPrimary")}
      <ArrowRightIcon />
    </a>
    <a
      href={localizePath("/platform/template", locale)}
      class={cn(buttonVariants({ size: "lg", variant: "outline" }))}
    >
      <MagnifyingGlassIcon />
      {t("ctaSecondary")}
    </a>
  </div>

  <dl
    class="landing-rise mt-14 grid max-w-2xl grid-cols-3 divide-x divide-foreground/15 border-y border-foreground/15"
    style="--rise: 4"
  >
    {
      STATS.map((stat) => (
        <div class="px-4 py-4 first:pl-0">
          <dt class="font-display text-2xl font-semibold text-foreground sm:text-3xl">
            {t(stat.valueKey)}
          </dt>
          <dd class="mt-1 text-xs text-muted-foreground sm:text-sm">
            {t(stat.labelKey)}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
