---
import {
  type Locale,
  localeStaticPaths,
  localizePath,
} from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { A, O, pipe, S } from "@mobily/ts-belt";
import DownloadHelp from "@/components/download/download-help.astro";
import DownloadPlatformList from "@/components/download/download-platform-list.astro";
import DownloadRecommended from "@/components/download/download-recommended.astro";
import LandingProsePage from "@/components/landing/landing-prose-page.astro";
import { CHANGELOG } from "@/lib/changelog";
import { CHANGELOG_PATHNAME } from "@/lib/routes";
import detectOsScript from "@/scripts/detect-os.js?raw";

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const locale = Astro.props.locale;
const t = getTranslator(locale, "download");
const version = pipe(
  A.head(CHANGELOG),
  O.mapWithDefault("", (release) => release.version),
);
---

<LandingProsePage
  locale={locale}
  title={t("metaTitle")}
  description={t("metaDescription")}
  width="full"
>
  <script slot="head" is:inline set:html={detectOsScript} />
  <header class="grid grid-cols-1 gap-6 pb-12 md:grid-cols-12 md:items-end md:gap-10 md:pb-16">
    <h1 class="text-[clamp(2.5rem,6.4vw,5rem)] leading-[0.95] font-extrabold tracking-[-0.035em] text-balance md:col-span-7">
      {t("heading")}
    </h1>
    <div class="md:col-span-5 md:pb-2">
      <p class="max-w-[42ch] text-base text-muted-foreground sm:text-lg">
        {t("lead")}
      </p>
      {
        !S.isEmpty(version) && (
          <p class="mt-3 text-sm text-muted-foreground">
            {t("version", { version })} ·{" "}
            <a
              href={localizePath(CHANGELOG_PATHNAME, locale)}
              class="rounded-xs font-medium text-foreground underline underline-offset-4 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            >
              {t("whatsNew")}
            </a>
          </p>
        )
      }
    </div>
  </header>
  <DownloadRecommended locale={locale} />
  <DownloadPlatformList locale={locale} />
  <DownloadHelp locale={locale} />
</LandingProsePage>
