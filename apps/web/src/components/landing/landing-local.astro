---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import {
  ArrowUpRightIcon,
  CheckIcon,
  CloudSlashIcon,
  LaptopIcon,
} from "@phosphor-icons/react";
import { REPO_URL } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "landing");

const ON_DEVICE = [
  "localSimpleResumes",
  "localSimpleProfiles",
  "localSimpleSettings",
] as const;
---

<section class="mx-auto w-11/12 max-w-6xl pb-24 md:pb-36">
  <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-center md:gap-12">
    <div class="md:col-span-6">
      <h2
        class="text-[clamp(2rem,4vw,3rem)] leading-[1.02] font-extrabold tracking-[-0.03em] text-balance"
      >
        {t("localHeading")}
      </h2>
      <p class="mt-5 max-w-[52ch] text-muted-foreground">{t("localBody")}</p>
      <p class="mt-6 text-sm">
        {t("localSource")}{" "}
        <a
          href={REPO_URL}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-1 rounded-xs font-medium underline underline-offset-4 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        >
          {t("localSourceLink")}
          <ArrowUpRightIcon aria-hidden="true" className="size-3.5" />
          <span class="sr-only">{t("newTab")}</span>
        </a>
      </p>
    </div>

    <figure class="md:col-span-6">
      <figcaption class="mb-3 text-sm text-muted-foreground">
        {t("localPanelCaption")}
      </figcaption>
      <div
        class="flex flex-col gap-6 rounded-xl bg-card p-6 ring-1 ring-foreground/10 md:p-8"
      >
        <div>
          <p class="flex items-center gap-2 font-semibold">
            <LaptopIcon aria-hidden="true" className="size-5 text-primary" />
            {t("localSimpleDevice")}
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              ON_DEVICE.map((key) => (
                <li class="flex items-center gap-2.5">
                  <CheckIcon
                    aria-hidden="true"
                    weight="bold"
                    className="size-4 shrink-0 text-primary"
                  />
                  {t(key)}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t pt-5">
          <p class="flex items-center gap-2 font-semibold">
            <CloudSlashIcon
              aria-hidden="true"
              className="size-5 text-muted-foreground"
            />
            {t("localSimpleServer")}
          </p>
          <p class="mt-2 text-muted-foreground">{t("localSimpleNothing")}</p>
        </div>
      </div>
    </figure>
  </div>
</section>
