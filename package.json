  "author": "Rizki Citra",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm run \"/^dev:(astro|api)$/\"",
    "generate:og": "tsx scripts/generate-og.tsx",
    "build": "pnpm generate:og && astro build",
    "desktop:dev": "LANJUT_TARGET=desktop tauri dev",
    "desktop:build": "LANJUT_TARGET=desktop tauri build",
    "preview": "astro build && wrangler dev",
    "ship": "astro build && wrangler deploy",
    "upload": "astro build && wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker/cloudflare-env.d.ts",
    "lint": "biome check",
    "typecheck": "astro check",
    "format": "biome format --write",
    "validate:exports": "tsx scripts/validate-exports.tsx",
    "commit": "cz",
    "ui:add": "pnpm dlx shadcn add",
    "prepare": "husky",
    "dev:astro": "astro dev",
    "dev:api": "wrangler dev --port 8787 --assets public"
  },
