---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { O, pipe, S } from "@mobily/ts-belt";
import {
  AppleLogoIcon,
  DevicesIcon,
  FileArrowUpIcon,
  FilePdfIcon,
  GaugeIcon,
  PaletteIcon,
  SquaresFourIcon,
  TranslateIcon,
  UsersThreeIcon,
  WifiSlashIcon,
  WindowsLogoIcon,
} from "@phosphor-icons/react";
import { LinuxMarkIcon } from "@/components/shared/brand-icons";
import LandingDownloadButton from "./landing-download-button.astro";
import LandingFeatureCard from "./landing-feature-card.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "landing.features");

// A bento grid on three columns: profiles and offline take the full width of
// their rows, the rest take one cell each.
const GRID = [
  { key: "templates", Icon: SquaresFourIcon },
  { key: "import", Icon: FileArrowUpIcon },
  { key: "export", Icon: FilePdfIcon },
  { key: "readiness", Icon: GaugeIcon },
  { key: "backup", Icon: DevicesIcon },
  { key: "languages", Icon: TranslateIcon },
  { key: "style", Icon: PaletteIcon },
] as const;

const PROFILE_EXAMPLES = ["one", "two", "three"] as const;

function initialOf(name: string): string {
  return pipe(S.get(name, 0), O.getWithDefault(""));
}
---

<section class="mx-auto w-11/12 max-w-6xl pb-24 md:pb-36">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-end md:gap-12">
    <h2
      class="text-[clamp(2rem,4vw,3rem)] leading-[1.02] font-extrabold tracking-[-0.03em] text-balance md:col-span-7"
    >
      {t("heading")}
    </h2>
    <p class="max-w-[52ch] text-muted-foreground md:col-span-5">{t("body")}</p>
  </div>

  <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-16 lg:grid-cols-3">
    <LandingFeatureCard
      title={t("items.profiles.title")}
      body={t("items.profiles.body")}
      icon={UsersThreeIcon}
      class="sm:col-span-2"
    >
      <ul class="mt-2 flex flex-wrap gap-2" aria-hidden="true">
        {
          PROFILE_EXAMPLES.map((example, index) => (
            <li
              class:list={[
                "inline-flex items-center gap-2 rounded-full border border-border px-3 py-1.5 text-sm",
                index === 0 && "border-primary/40 bg-primary/5 font-medium",
              ]}
            >
              <span class="grid size-5 place-items-center rounded-full bg-primary/15 text-[0.625rem] font-semibold text-primary">
                {initialOf(t(`profileExamples.${example}`))}
              </span>
              {t(`profileExamples.${example}`)}
            </li>
          ))
        }
      </ul>
    </LandingFeatureCard>
    {
      GRID.map((item) => (
        <LandingFeatureCard
          title={t(`items.${item.key}.title`)}
          body={t(`items.${item.key}.body`)}
          icon={item.Icon}
        />
      ))
    }
    <LandingFeatureCard
      title={t("items.offline.title")}
      body={t("items.offline.body")}
      icon={WifiSlashIcon}
      class="sm:col-span-2 lg:col-span-3"
    >
      <div class="mt-2 flex flex-wrap items-center gap-4">
        <LandingDownloadButton locale={locale} variant="default" />
        <span class="flex gap-3 text-muted-foreground" aria-hidden="true">
          <AppleLogoIcon weight="fill" className="size-5" />
          <WindowsLogoIcon weight="fill" className="size-5" />
          <LinuxMarkIcon className="size-5" />
        </span>
      </div>
    </LandingFeatureCard>
  </ul>
</section>
