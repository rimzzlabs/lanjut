---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "ui");

// Each line of the sheet: its box and its turn in the writing order.
const LINES = [
  { x: 51, y: 22.5, width: 26, height: 4, strong: true },
  { x: 51, y: 29.5, width: 16, height: 2.5 },
  { x: 38, y: 41, width: 12, height: 2.5, heading: true },
  { x: 38, y: 47, width: 44, height: 2 },
  { x: 38, y: 52, width: 40, height: 2 },
  { x: 38, y: 57, width: 30, height: 2 },
  { x: 38, y: 66, width: 14, height: 2.5, heading: true },
  { x: 38, y: 72, width: 42, height: 2 },
  { x: 38, y: 77, width: 36, height: 2 },
  { x: 38, y: 82, width: 24, height: 2 },
];
---

<div role="status" class="grid min-h-dvh place-items-center bg-background">
  <svg
    viewBox="0 0 120 120"
    class="loader size-32"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <clipPath id="loader-sheet-clip">
        <rect x="30" y="12" width="60" height="84" rx="4"></rect>
      </clipPath>
      <clipPath id="loader-mark-clip">
        <circle cx="32" cy="32" r="32"></circle>
      </clipPath>
      <linearGradient id="loader-beam-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="loader-beam-stop" stop-opacity="0"></stop>
        <stop offset="0.75" class="loader-beam-stop" stop-opacity="0.3"></stop>
        <stop offset="1" class="loader-beam-stop" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    <ellipse class="loader-shadow" cx="60" cy="104" rx="24" ry="2.5"></ellipse>

    <g class="loader-sheet">
      <rect class="loader-paper" x="30" y="12" width="60" height="84" rx="4"
      ></rect>
      <g clip-path="url(#loader-sheet-clip)">
        <circle class="loader-ink loader-avatar" cx="42.5" cy="27" r="5"
        ></circle>
        {
          LINES.map((line, index) => (
            <rect
              class:list={[
                "loader-ink",
                "loader-line",
                { "loader-strong": line.strong, "loader-heading": line.heading },
              ]}
              x={line.x}
              y={line.y}
              width={line.width}
              height={line.height}
              rx={line.height / 2}
              style={`--i: ${index + 1}`}
            />
          ))
        }
        <rect
          class="loader-beam"
          x="30"
          y="-6"
          width="60"
          height="16"
          fill="url(#loader-beam-fill)"></rect>
      </g>
    </g>

    <g class="loader-burst">
      <path d="M88 2.5 V-0.5"></path>
      <path d="M97 6 L99.2 3.8"></path>
      <path d="M100.5 15 H103.5"></path>
    </g>

    <g class="loader-badge">
      <g transform="translate(88 15) scale(0.28) translate(-32 -32)">
        <circle class="loader-mark" cx="32" cy="32" r="32"></circle>
        <g clip-path="url(#loader-mark-clip)">
          <path
            class="loader-ribbon"
            d="M14 18 H42 C51 18 51 32 42 32 H22 C13 32 13 46 22 46 H72"
            pathLength="100"></path>
        </g>
      </g>
    </g>
  </svg>
  <span class="sr-only">{t("loading")}</span>
</div>

<style>
  /* A sheet writes its own lines, a scan beam reads them (the second reader),
     and the Lanjut mark stamps the corner. Every element rests on that finished
     picture, so reduced motion and a stalled animation still show it. */
  .loader {
    --loader-cycle: 3.2s;
    --loader-ink: oklch(0.2 0.014 155 / 0.2);
    --loader-green: #0e8a66;
    overflow: visible;
  }

  .loader-shadow {
    fill: var(--foreground);
    opacity: 0.1;
    transform-box: fill-box;
    transform-origin: center;
  }

  .loader-sheet {
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  .loader-paper {
    fill: #fff;
    stroke: var(--border);
    stroke-width: 1;
  }

  .loader-ink {
    fill: var(--loader-ink);
  }

  .loader-strong {
    --loader-ink: oklch(0.2 0.014 155 / 0.42);
  }

  .loader-line,
  .loader-avatar {
    transform-box: fill-box;
    transform-origin: left center;
  }

  .loader-avatar {
    transform-origin: center;
  }

  .loader-beam {
    opacity: 0;
  }

  .loader-beam-stop {
    stop-color: var(--loader-green);
  }

  .loader-burst {
    fill: none;
    stroke: var(--loader-green);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0;
    transform-box: view-box;
    transform-origin: 88px 15px;
  }

  .loader-badge {
    transform-box: fill-box;
    transform-origin: center;
  }

  .loader-mark {
    fill: var(--loader-green);
  }

  .loader-ribbon {
    fill: none;
    stroke: #fff;
    stroke-width: 6.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
  }

  :root[data-motion="full"] .loader-line {
    animation:
      loader-write var(--loader-cycle) calc(var(--i) * 70ms) infinite both,
      loader-read var(--loader-cycle) calc(var(--i) * 40ms) infinite both;
  }

  :root[data-motion="full"] .loader-avatar {
    animation:
      loader-pop var(--loader-cycle) infinite both,
      loader-read var(--loader-cycle) infinite both;
  }

  :root[data-motion="full"] .loader-beam {
    animation: loader-scan var(--loader-cycle) infinite both;
  }

  :root[data-motion="full"] .loader-sheet {
    animation: loader-hop var(--loader-cycle) infinite both;
  }

  :root[data-motion="full"] .loader-shadow {
    animation: loader-shadow var(--loader-cycle) infinite both;
  }

  :root[data-motion="full"] .loader-badge {
    animation: loader-stamp var(--loader-cycle) infinite both;
  }

  :root[data-motion="full"] .loader-ribbon {
    animation: loader-ribbon var(--loader-cycle) infinite both;
  }

  :root[data-motion="full"] .loader-burst {
    animation: loader-burst var(--loader-cycle) infinite both;
  }

  :root[data-motion="reduce"] .loader-line {
    animation: loader-breathe 1.6s calc(var(--i) * 90ms) ease-in-out infinite;
  }

  @keyframes loader-write {
    0% {
      transform: scaleX(0);
      animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    14%,
    82% {
      transform: scaleX(1);
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0);
    }
    92%,
    100% {
      transform: scaleX(0);
    }
  }

  @keyframes loader-pop {
    0% {
      transform: scale(0);
      animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    12%,
    82% {
      transform: scale(1);
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0);
    }
    92%,
    100% {
      transform: scale(0);
    }
  }

  @keyframes loader-read {
    0%,
    41% {
      fill: var(--loader-ink);
    }
    45%,
    88% {
      fill: var(--loader-green);
    }
    94%,
    100% {
      fill: var(--loader-ink);
    }
  }

  @keyframes loader-scan {
    0%,
    37% {
      opacity: 0;
      transform: translateY(0);
    }
    39% {
      opacity: 1;
    }
    58% {
      opacity: 1;
      transform: translateY(104px);
    }
    60%,
    100% {
      opacity: 0;
      transform: translateY(104px);
    }
  }

  @keyframes loader-stamp {
    0%,
    58% {
      opacity: 0;
      transform: scale(0) rotate(-30deg);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    59% {
      opacity: 1;
    }
    64% {
      transform: scale(1.22) rotate(6deg);
    }
    69% {
      transform: scale(0.94) rotate(-2deg);
    }
    73%,
    86% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
      animation-timing-function: cubic-bezier(0.5, 0, 0.75, 0);
    }
    92%,
    100% {
      opacity: 0;
      transform: scale(0) rotate(0deg);
    }
  }

  @keyframes loader-ribbon {
    0%,
    62% {
      stroke-dashoffset: 100;
    }
    76%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes loader-burst {
    0%,
    63% {
      opacity: 0;
      transform: scale(0.5);
    }
    66% {
      opacity: 1;
      transform: scale(1);
    }
    76%,
    100% {
      opacity: 0;
      transform: scale(1.3);
    }
  }

  @keyframes loader-hop {
    0%,
    62% {
      transform: none;
    }
    65% {
      transform: translateY(1.5px) scaleY(0.97);
    }
    70% {
      transform: translateY(-1.5px) scaleY(1.01);
    }
    75%,
    100% {
      transform: none;
    }
  }

  @keyframes loader-shadow {
    0%,
    62% {
      transform: none;
    }
    65% {
      transform: scaleX(1.06);
    }
    70% {
      transform: scaleX(0.94);
    }
    75%,
    100% {
      transform: none;
    }
  }

  @keyframes loader-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }
</style>
