---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { buttonVariants } from "@lanjut/ui/components/button";
import { cn } from "@lanjut/ui/lib/utils";
import {
  AppleLogoIcon,
  DownloadSimpleIcon,
  LinuxLogoIcon,
  WindowsLogoIcon,
} from "@phosphor-icons/react";
import { DESKTOP_RELEASE_URL } from "@/lib/site";

interface Props {
  locale: Locale;
}

// The build is unsigned, so macOS blocks it on first open and calls it
// damaged. The warning sits next to the button on purpose: a user who meets it
// with no explanation concludes the app is broken.
const { locale } = Astro.props;
const t = getTranslator(locale, "landing");
---

<section class="mx-auto w-11/12 max-w-6xl pb-24 md:pb-36">
  <h2
    class="text-[clamp(2rem,4vw,3rem)] leading-[1.02] font-extrabold tracking-[-0.03em]"
  >
    {t("appHeading")}
  </h2>
  <p class="mt-5 max-w-[52ch] text-muted-foreground">{t("appBody")}</p>

  <div
    class="mt-10 grid gap-6 border-y border-border py-8 md:grid-cols-12 md:items-center"
  >
    <div class="flex items-center gap-4 md:col-span-5">
      <AppleLogoIcon aria-hidden="true" weight="fill" className="size-9" />
      <div>
        <p class="text-2xl font-bold tracking-tight">macOS</p>
        <p class="font-machine text-xs text-muted-foreground">{t("macMeta")}</p>
      </div>
    </div>
    <div class="flex flex-col items-start gap-3 md:col-span-7 md:items-end">
      <a
        href={DESKTOP_RELEASE_URL}
        target="_blank"
        rel="noreferrer"
        class={cn(buttonVariants({ size: "lg" }), "h-11 gap-2 px-5")}
      >
        <DownloadSimpleIcon />
        {t("macCta")}
        <span class="sr-only">{t("newTab")}</span>
      </a>
      <p class="max-w-[46ch] text-xs text-pretty text-muted-foreground md:text-right">
        {t("macNote")}
      </p>
    </div>
  </div>
  <p class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
    <WindowsLogoIcon aria-hidden="true" weight="fill" className="size-4" />
    <LinuxLogoIcon aria-hidden="true" weight="fill" className="size-4" />
    {t("otherPlatforms")}
  </p>
</section>
