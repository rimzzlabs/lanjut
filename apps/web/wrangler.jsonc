{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "name": "lanjut",
  "keep_names": false,
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Shared modules read the build target the way Astro inlines it.
  "define": {
    "import.meta.env.PUBLIC_LANJUT_TARGET": "\"\""
  },
  "routes": [
    {
      "pattern": "lanjut.org",
      "custom_domain": true
    },
    // Kept so the old host stays proxied. A zone redirect rule sends it to lanjut.org.
    {
      "pattern": "lanjut.rimzzlabs.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Static files skip the Worker, except the paths it decides on: the
    // feedback relay, unprefixed pages that a language choice redirects, and
    // addresses from before the static site.
    "run_worker_first": [
      "/api/*",
      "/",
      "/platform",
      "/platform/*",
      "/editor",
      "/editor/*",
      "/id/editor",
      "/id/editor/*",
      "/template",
      "/profile",
      "/changelog",
      "/feedback",
      "/feedback/*",
      "/id/platform",
      "/id/platform/*",
      "/en",
      "/en/*"
    ]
  }
}
