.vercel

# cloudflare
.wrangler/
.dev.vars*
cloudflare-env.d.ts

# typescript
*.tsbuildinfo

# Tauri build output: gigabytes, never tracked
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
