---
import { type Locale, localizePath } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { buttonVariants } from "@lanjut/ui/components/button";
import { cn } from "@lanjut/ui/lib/utils";
import { EDITOR_PATHNAME, TEMPLATE_PATHNAME } from "@/lib/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "guide");
---

<aside class="mt-16 rounded-xl bg-card p-6 ring-1 ring-foreground/10 md:p-8">
  <h2 class="text-2xl font-bold tracking-tight">{t("ctaHeading")}</h2>
  <p class="mt-2 text-muted-foreground">{t("ctaBody")}</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a
      href={`${localizePath(EDITOR_PATHNAME, locale)}?create=true`}
      class={cn(buttonVariants({ size: "lg" }), "h-11 px-5")}
    >
      {t("ctaBuild")}
    </a>
    <a
      href={localizePath(TEMPLATE_PATHNAME, locale)}
      class={cn(buttonVariants({ size: "lg", variant: "outline" }), "h-11 px-5")}
    >
      {t("ctaTemplates")}
    </a>
  </div>
</aside>
