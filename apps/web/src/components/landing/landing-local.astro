---
import { type Locale, localizePath } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import {
  ArrowRightIcon,
  CloudSlashIcon,
  FloppyDiskIcon,
  UserCircleDashedIcon,
} from "@phosphor-icons/react";
import { PRIVACY_PATHNAME } from "@/lib/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "landing.proof");

const FACTS = [
  { key: "noAccount", Icon: UserCircleDashedIcon },
  { key: "noUpload", Icon: CloudSlashIcon },
  { key: "backup", Icon: FloppyDiskIcon },
] as const;
---

{/* The one inverted band on the page. It backs the local-first pillar with
    three facts and a link to the page that lists every network call. */}
<section class="mx-auto w-11/12 max-w-6xl pb-24 md:pb-36">
  <div class="rounded-2xl bg-foreground px-6 py-12 text-background md:px-12 md:py-16">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-end md:gap-12">
      <h2
        class="text-[clamp(2rem,4vw,3rem)] leading-[1.02] font-extrabold tracking-[-0.03em] text-balance md:col-span-7"
      >
        {t("heading")}
      </h2>
      <p class="max-w-[52ch] text-background/70 md:col-span-5">{t("body")}</p>
    </div>

    <ul
      class="mt-12 grid grid-cols-1 gap-8 border-t border-background/15 pt-10 md:mt-16 md:grid-cols-3"
    >
      {
        FACTS.map((fact) => (
          <li class="flex flex-col gap-3">
            <span class="grid size-11 place-items-center rounded-lg bg-background/10">
              <fact.Icon aria-hidden="true" weight="duotone" className="size-6" />
            </span>
            <h3 class="text-lg font-bold tracking-tight">{t(`${fact.key}.title`)}</h3>
            <p class="text-background/70">{t(`${fact.key}.body`)}</p>
          </li>
        ))
      }
    </ul>

    <a
      href={localizePath(PRIVACY_PATHNAME, locale)}
      class="mt-10 inline-flex items-center gap-2 rounded-xs font-medium underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-background md:mt-12"
    >
      {t("privacyLink")}
      <ArrowRightIcon aria-hidden="true" className="size-4" />
    </a>
  </div>
</section>
