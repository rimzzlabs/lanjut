---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { buttonVariants } from "@lanjut/ui/components/button";
import { cn } from "@lanjut/ui/lib/utils";
import {
  AppleLogoIcon,
  DownloadSimpleIcon,
  LinuxLogoIcon,
  WindowsLogoIcon,
} from "@phosphor-icons/react";
import { DESKTOP_RELEASE_URL } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "landing");

const PLATFORMS = [
  { name: "macOS", key: "mac", Icon: AppleLogoIcon },
  { name: "Windows", key: "win", Icon: WindowsLogoIcon },
  { name: "Linux", key: "linux", Icon: LinuxLogoIcon },
] as const;
---

<section class="mx-auto w-11/12 max-w-6xl pb-24 md:pb-36">
  <h2
    class="text-[clamp(2rem,4vw,3rem)] leading-[1.02] font-extrabold tracking-[-0.03em]"
  >
    {t("appHeading")}
  </h2>
  <p class="mt-5 max-w-[52ch] text-muted-foreground">{t("appBody")}</p>

  <ul class="mt-10 border-t border-border">
    {
      PLATFORMS.map((platform) => (
        <li class="grid gap-6 border-b border-border py-8 md:grid-cols-12 md:items-center">
          <div class="flex items-center gap-4 md:col-span-5">
            <platform.Icon aria-hidden="true" weight="fill" className="size-9 shrink-0" />
            <div>
              <p class="text-2xl font-bold tracking-tight">{platform.name}</p>
              <p class="font-machine text-xs text-muted-foreground">
                {t(`${platform.key}Meta`)}
              </p>
            </div>
          </div>
          <div class="flex flex-col items-start gap-3 md:col-span-7 md:items-end">
            <a
              href={DESKTOP_RELEASE_URL}
              target="_blank"
              rel="noreferrer"
              class={cn(
                buttonVariants({ size: "lg", variant: "outline" }),
                "h-11 gap-2 px-5",
              )}
            >
              <DownloadSimpleIcon />
              {t(`${platform.key}Cta`)}
              <span class="sr-only">{t("newTab")}</span>
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>
