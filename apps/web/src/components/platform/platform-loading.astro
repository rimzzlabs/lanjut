---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { CircleNotchIcon } from "@phosphor-icons/react";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "ui");
---

<div role="status" class="grid min-h-dvh place-items-center bg-background">
  <div class="flex flex-col items-center gap-4">
    <img src="/favicon.svg" alt="" width="40" height="40" class="size-10" />
    <CircleNotchIcon
      aria-hidden="true"
      className="size-5 text-muted-foreground motion-safe:animate-spin"
    />
    <span class="sr-only">{t("loading")}</span>
  </div>
</div>
