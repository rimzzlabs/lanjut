---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { LandingReaders } from "./landing-readers";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = getTranslator(locale, "landing");
---

<section class="mx-auto w-11/12 max-w-6xl pt-10 pb-24 md:pt-16 md:pb-36">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:items-end md:gap-10">
    <h1
      class="landing-rise text-[clamp(2.75rem,7.4vw,6rem)] leading-[0.95] font-extrabold tracking-[-0.035em] text-balance md:col-span-8"
      style="--rise: 0"
    >
      <span class="sr-only">{t("srHeading")}</span>
      {t("headingLine1")}
      <br />
      {t("headingLead")}<span class="text-primary">{t("headingAccent")}</span>
    </h1>
    <p
      class="landing-rise max-w-[42ch] text-base text-muted-foreground sm:text-lg md:col-span-4 md:pb-2"
      style="--rise: 1"
    >
      {t("deck")}
    </p>
  </div>

  <div class="landing-rise mt-10 md:mt-14" style="--rise: 2">
    <LandingReaders client:load locale={locale} pathname={pathname} />
  </div>
</section>
