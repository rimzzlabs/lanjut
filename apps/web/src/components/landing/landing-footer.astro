---
import { type Locale, localizePath } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { ArrowUpRightIcon } from "@phosphor-icons/react";
import { EDITOR_PATHNAME, TEMPLATE_PATHNAME } from "@/lib/routes";
import { DESKTOP_RELEASE_URL, DONATION_LINKS, REPO_URL } from "@/lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "landing.footer");
const tLanding = getTranslator(locale, "landing");
const tSidebar = getTranslator(locale, "platform.sidebar");
const year = new Date().getFullYear();

const feedbackHref = localizePath("/feedback", locale);

// A plain link to the page in the other language. The language menu sets a
// cookie and reloads, which a crawler cannot follow.
const OTHER_LOCALE: Record<Locale, Locale> = { en: "id", id: "en" };
const LANGUAGE_NAME: Record<Locale, string> = {
  en: "English",
  id: "Bahasa Indonesia",
};
const otherLocale = OTHER_LOCALE[locale];

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
  logo?: string;
}

const GROUPS: ReadonlyArray<{
  id: string;
  title: string;
  links: ReadonlyArray<FooterLink>;
}> = [
  {
    id: "footer-product",
    title: t("product"),
    links: [
      { label: t("editor"), href: localizePath(EDITOR_PATHNAME, locale) },
      {
        label: t("templates"),
        href: localizePath(TEMPLATE_PATHNAME, locale),
      },
      { label: t("download"), href: DESKTOP_RELEASE_URL, external: true },
    ],
  },
  {
    id: "footer-project",
    title: t("project"),
    links: [
      { label: t("github"), href: REPO_URL, external: true },
      { label: tSidebar("reportBug"), href: `${feedbackHref}?kind=bug` },
      {
        label: tSidebar("featureRequest"),
        href: `${feedbackHref}?kind=idea`,
      },
    ],
  },
  {
    id: "footer-support",
    title: t("support"),
    links: [
      {
        label: "Saweria",
        href: DONATION_LINKS.saweria,
        external: true,
        logo: "/brands/saweria.png",
      },
      {
        label: "SociaBuzz",
        href: DONATION_LINKS.sociabuzz,
        external: true,
        logo: "/brands/sociabuzz.png",
      },
    ],
  },
];

const LINK_CLASS =
  "inline-flex items-center gap-1.5 rounded-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

<footer class="mx-auto w-11/12 max-w-6xl border-t border-border pt-12 pb-28 md:pb-14">
  <div class="grid gap-12 md:grid-cols-[1fr_auto] md:gap-16">
    <div>
      <a
        href={localizePath("/", locale)}
        class="inline-flex items-center gap-2 rounded-xs font-brand text-lg font-bold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        <img src="/favicon.svg" alt="" width="22" height="22" class="size-5.5" />
        Lanjut
      </a>
      <p class="mt-3 max-w-xs text-sm text-muted-foreground">{t("tagline")}</p>
      <p class="mt-8 text-xs text-muted-foreground">{t("rights", { year })}</p>
      <a
        href={localizePath("/", otherLocale)}
        hreflang={otherLocale}
        lang={otherLocale}
        class={`mt-2 text-xs ${LINK_CLASS}`}
      >
        {LANGUAGE_NAME[otherLocale]}
      </a>
    </div>

    <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 sm:gap-16">
      {
        GROUPS.map((group) => (
          <nav aria-labelledby={group.id}>
            <h2 id={group.id} class="text-sm font-semibold">
              {group.title}
            </h2>
            <ul class="mt-4 flex flex-col gap-2.5 text-sm">
              {group.links.map((link) => (
                <li>
                  {link.external && (
                    <a href={link.href} target="_blank" rel="noreferrer" class={LINK_CLASS}>
                      {link.logo && (
                        <img src={link.logo} alt="" width="14" height="14" class="size-3.5" />
                      )}
                      {link.label}
                      <ArrowUpRightIcon aria-hidden="true" className="size-3" />
                      <span class="sr-only">{tLanding("newTab")}</span>
                    </a>
                  )}
                  {!link.external && (
                    <a href={link.href} class={LINK_CLASS}>
                      {link.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
</footer>
