---
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { DESKTOP_PLATFORMS } from "./landing-download-platforms";
import LandingDownloadRow from "./landing-download-row.astro";

interface Props {
  locale: Locale;
}

// No build is signed, so macOS and Windows warn on the first open. Each note
// sits next to its button on purpose: a user who meets the warning with no
// explanation concludes the app is broken.
const { locale } = Astro.props;
const t = getTranslator(locale, "landing");
---

<section class="mx-auto w-11/12 max-w-6xl pb-24 md:pb-36">
  <h2
    class="text-[clamp(2rem,4vw,3rem)] leading-[1.02] font-extrabold tracking-[-0.03em]"
  >
    {t("appHeading")}
  </h2>
  <p class="mt-5 max-w-[52ch] text-muted-foreground">{t("appBody")}</p>

  <ul class="mt-10 divide-y divide-border border-y border-border">
    {
      DESKTOP_PLATFORMS.map((platform) => (
        <LandingDownloadRow locale={locale} platform={platform} />
      ))
    }
  </ul>
</section>
