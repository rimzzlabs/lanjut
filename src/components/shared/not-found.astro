---
import RootLayout from "@/components/shared/root-layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { type Locale, localizePath } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { cn } from "@/lib/utils";

interface Props {
  locale: Locale;
}

const locale = Astro.props.locale;
const t = getTranslator(locale, "notFound");
---

<RootLayout locale={locale} title={t("metaTitle")} noindex>
  <main
    id="main"
    class="mx-auto flex min-h-svh w-11/12 max-w-xl flex-col items-start justify-center gap-4"
  >
    <p class="font-mono text-xs tracking-[0.18em] text-primary uppercase">404</p>
    <h1 class="font-display text-3xl font-semibold tracking-tight">
      {t("title")}
    </h1>
    <p class="text-muted-foreground">{t("body")}</p>
    <a href={localizePath("/", locale)} class={cn(buttonVariants())}>{t("home")}</a>
  </main>
</RootLayout>
