---
import type { Locale } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { LandingTryIt } from "./landing-try-it";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = getTranslator(locale, "tryIt");
---

<section class="mx-auto w-11/12 max-w-5xl pb-24 md:pb-32">
  <div class="landing-reveal max-w-2xl">
    <p class="font-mono text-xs tracking-[0.18em] text-primary uppercase">
      {t("kicker")}
    </p>
    <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl">
      {t("heading")}
    </h2>
    <p class="mt-4 text-base text-foreground/70 sm:text-lg">
      {t("description")}
    </p>
  </div>

  <div class="landing-reveal mt-10 md:mt-12">
    <LandingTryIt client:visible locale={locale} pathname={pathname} />
  </div>
</section>
