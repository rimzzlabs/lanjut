---
import { AppleLogoIcon, WindowsLogoIcon } from "@phosphor-icons/react";
import { LinuxMarkIcon } from "@/components/shared/brand-icons";
import type { DownloadOs } from "./download-platforms";

interface Props {
  os: DownloadOs;
  class?: string;
}

const { os } = Astro.props;
---

{os === "mac" && <AppleLogoIcon aria-hidden="true" weight="fill" className={Astro.props.class} />}
{os === "windows" && <WindowsLogoIcon aria-hidden="true" weight="fill" className={Astro.props.class} />}
{os === "linux" && <LinuxMarkIcon className={Astro.props.class} />}
