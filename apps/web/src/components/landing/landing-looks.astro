---
import type { Locale } from "@lanjut/i18n/routing";
import { LandingLooks } from "./landing-looks";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
---

<section class="mx-auto w-11/12 max-w-6xl pb-24 md:pb-36">
  <LandingLooks client:visible locale={locale} pathname={pathname} />
</section>
