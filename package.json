{
  "name": "lanjut",
  "version": "0.18.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Rizki Citra",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @lanjut/web dev",
    "build": "pnpm --filter @lanjut/web build",
    "preview": "pnpm --filter @lanjut/web preview",
    "ship": "pnpm --filter @lanjut/web ship",
    "upload": "pnpm --filter @lanjut/web upload",
    "validate:exports": "pnpm --filter @lanjut/web validate:exports",
    "cf-typegen": "pnpm --filter @lanjut/web cf-typegen",
    "desktop:dev": "pnpm --filter @lanjut/desktop dev",
    "desktop:build": "pnpm --filter @lanjut/desktop build",
    "ui:add": "pnpm --filter @lanjut/ui ui:add",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check && prettier --check \"**/*.{md,yml,yaml}\"",
    "format": "biome format --write && prettier --write \"**/*.{md,yml,yaml}\"",
    "commit": "cz",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.9",
    "typescript": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
