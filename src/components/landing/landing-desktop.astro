---
import { ArrowUpRightIcon, DownloadSimpleIcon } from "@phosphor-icons/react";
import { buttonVariants } from "@/components/ui/button";
import type { Locale } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { DESKTOP_RELEASE_URL } from "@/lib/site";
import { cn } from "@/lib/utils";

interface Props {
  locale: Locale;
}

// The build is unsigned, so macOS blocks it on first open and calls it
// damaged. The warning sits next to the button on purpose: a user who meets it
// with no explanation concludes the app is broken.
const { locale } = Astro.props;
const t = getTranslator(locale, "desktop");
---

<section class="mx-auto w-11/12 max-w-5xl pb-24 md:pb-32">
  <div
    class="landing-reveal flex flex-col gap-6 rounded-2xl border bg-card p-8 md:flex-row md:items-center md:justify-between md:p-10"
  >
    <div class="max-w-xl">
      <p class="font-mono text-xs tracking-[0.18em] text-primary uppercase">
        {t("kicker")}
      </p>
      <h2
        class="mt-3 font-display text-2xl font-semibold tracking-tight text-balance sm:text-3xl"
      >
        {t("heading")}
      </h2>
      <p class="mt-3 text-foreground/70 text-sm sm:text-base">
        {t("description")}
      </p>
    </div>

    <div class="flex shrink-0 flex-col items-start gap-2 md:items-end">
      <a
        href={DESKTOP_RELEASE_URL}
        target="_blank"
        rel="noreferrer"
        class={cn(buttonVariants({ size: "lg", className: "gap-2" }))}
      >
        <DownloadSimpleIcon />
        {t("cta")}
        <ArrowUpRightIcon />
      </a>
      <p class="max-w-72 text-pretty text-muted-foreground text-xs md:text-right">
        {t("gatekeeper")}
      </p>
    </div>
  </div>
</section>
