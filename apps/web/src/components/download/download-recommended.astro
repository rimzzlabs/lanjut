---
import type { Locale } from "@lanjut/i18n/routing";
import { localizePath } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { buttonVariants } from "@lanjut/ui/components/button";
import { cn } from "@lanjut/ui/lib/utils";
import { BrowserIcon, DownloadSimpleIcon } from "@phosphor-icons/react";
import { desktopFileUrl } from "@/lib/desktop-files";
import { EDITOR_PATHNAME } from "@/lib/routes";
import DownloadOsIcon from "./download-os-icon.astro";
import {
  DOWNLOAD_PLATFORMS,
  RECOMMENDED_DOWNLOADS,
} from "./download-platforms";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "download");
---

{/* One card per system, and data-os-only shows the visitor's. Without the
    head script, no card shows and the full list below still carries every
    file. */}
<section aria-label={t("recommended")} class="pb-16 md:pb-24">
  {
    DOWNLOAD_PLATFORMS.map((platform) => {
      const pick = RECOMMENDED_DOWNLOADS[platform.os];
      return (
        <div
          data-os-only={platform.os}
          class="rounded-xl bg-card p-6 ring-1 ring-foreground/10 md:p-8"
        >
          <p class="text-sm text-muted-foreground">{t("recommended")}</p>
          <div class="mt-4 grid gap-6 md:grid-cols-12 md:items-center">
            <div class="flex items-center gap-4 md:col-span-5">
              <DownloadOsIcon os={platform.os} class="size-10 shrink-0" />
              <div>
                <p class="text-2xl font-bold tracking-tight">{platform.name}</p>
                <p class="text-sm text-muted-foreground">
                  {t(`requires.${platform.os}`)}
                </p>
              </div>
            </div>
            <div class="flex flex-col gap-3 md:col-span-7 md:items-end">
              <div class="flex flex-wrap gap-3">
                <a
                  href={desktopFileUrl(pick.primary)}
                  class={cn(buttonVariants({ size: "lg" }), "h-11 gap-2 px-5")}
                >
                  <DownloadSimpleIcon aria-hidden="true" />
                  {t(pick.cta)}
                </a>
                <a
                  href={desktopFileUrl(pick.secondary)}
                  class={cn(
                    buttonVariants({ size: "lg", variant: "outline" }),
                    "h-11 px-5",
                  )}
                >
                  {t(pick.secondaryLabel)}
                </a>
              </div>
              <p class="max-w-[48ch] text-sm text-muted-foreground md:text-right">
                {t(pick.note)}
              </p>
            </div>
          </div>
        </div>
      );
    })
  }
  <div
    data-os-only="web"
    class="rounded-xl bg-card p-6 ring-1 ring-foreground/10 md:p-8"
  >
    <div class="grid gap-6 md:grid-cols-12 md:items-center">
      <div class="flex items-start gap-4 md:col-span-8">
        <BrowserIcon aria-hidden="true" className="size-10 shrink-0" />
        <div>
          <p class="text-2xl font-bold tracking-tight">{t("webTitle")}</p>
          <p class="mt-2 max-w-[56ch] text-muted-foreground">{t("webBody")}</p>
        </div>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a
          href={localizePath(EDITOR_PATHNAME, locale)}
          class={cn(buttonVariants({ size: "lg" }), "h-11 px-5")}
        >
          {t("webCta")}
        </a>
      </div>
    </div>
  </div>
</section>
