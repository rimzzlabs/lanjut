---
import RootLayout from "@/components/shared/root-layout.astro";
import type { Locale } from "@/i18n/routing";
import { PlatformAppFromLocation } from "./platform-app-from-location";
import PlatformLoading from "./platform-loading.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<RootLayout locale={locale} noindex>
  <PlatformAppFromLocation client:only="react">
    <PlatformLoading slot="fallback" locale={locale} />
  </PlatformAppFromLocation>
</RootLayout>
