---
import {
  FileMagnifyingGlassIcon,
  HardDriveIcon,
  SealCheckIcon,
} from "@phosphor-icons/react";
import type { Locale } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "values");

const VALUES = [
  { icon: HardDriveIcon, titleKey: "localTitle", bodyKey: "localBody" },
  {
    icon: FileMagnifyingGlassIcon,
    titleKey: "parseTitle",
    bodyKey: "parseBody",
  },
  { icon: SealCheckIcon, titleKey: "freeTitle", bodyKey: "freeBody" },
];
---

<section class="mx-auto w-11/12 max-w-5xl pb-24 md:pb-32">
  <div
    class="landing-reveal grid gap-6 border-t border-foreground/15 pt-12 md:grid-cols-3 md:gap-10 md:pt-16"
  >
    {
      VALUES.map((value) => (
        <div>
          <value.icon className="size-5 text-primary" aria-hidden="true" />
          <h3 class="mt-4 font-display text-xl font-semibold tracking-tight">
            {t(value.titleKey)}
          </h3>
          <p class="mt-2 text-sm text-foreground/70">{t(value.bodyKey)}</p>
        </div>
      ))
    }
  </div>
</section>
