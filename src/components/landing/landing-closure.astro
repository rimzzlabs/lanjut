---
import { ArrowRight, Search } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { type Locale, localizePath } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { cn } from "@/lib/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "closure");
---

<section class="mx-auto w-11/12 max-w-5xl pb-24 md:pb-32">
  <div class="landing-reveal border-y-2 border-foreground py-16 md:py-24">
    <p class="font-mono text-xs tracking-[0.18em] text-primary uppercase">
      {t("kicker")}
    </p>
    <h2
      class="mt-4 max-w-3xl font-display text-[clamp(2rem,5vw,3.75rem)] leading-[1.04] font-semibold tracking-tight text-balance"
    >
      {t("heading")}
    </h2>
    <p class="mt-5 max-w-2xl text-base text-foreground/70 sm:text-lg">
      {t("description")}
    </p>
    <div
      class="mt-9 flex w-full max-w-xs flex-col gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:gap-4"
    >
      <a
        href={localizePath("/platform?create=true", locale)}
        class={cn(buttonVariants({ size: "lg", className: "gap-2" }))}
      >
        {t("ctaPrimary")}
        <ArrowRight />
      </a>
      <a
        href={localizePath("/platform/template", locale)}
        class={cn(buttonVariants({ size: "lg", variant: "outline" }))}
      >
        <Search />
        {t("ctaSecondary")}
      </a>
    </div>
  </div>
</section>
