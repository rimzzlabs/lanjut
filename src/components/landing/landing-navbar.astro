---
import { type Locale, localizePath } from "@/i18n/routing";
import { getTranslator } from "@/i18n/translator";
import { LandingNavbarActions } from "./landing-navbar-actions";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = getTranslator(locale, "nav");
---

<header
  class="sticky top-0 z-40 border-b border-foreground/15 bg-background/85 backdrop-blur"
>
  <div class="mx-auto flex h-16 w-11/12 max-w-5xl items-center">
    <a
      href={localizePath("/", locale)}
      class="inline-flex items-center gap-2 font-brand text-lg font-bold tracking-tight"
    >
      <img src="/favicon.svg" alt="" width="22" height="22" class="size-5.5" />
      Lanjut
    </a>

    <nav class="ml-auto hidden items-center gap-8 md:inline-flex">
      <a
        href={localizePath("/platform", locale)}
        class="text-sm text-foreground/70 transition-colors hover:text-foreground"
      >
        {t("dashboard")}
      </a>
      <a
        href={localizePath("/platform/template", locale)}
        class="text-sm text-foreground/70 transition-colors hover:text-foreground"
      >
        {t("templates")}
      </a>
    </nav>

    <LandingNavbarActions client:idle locale={locale} pathname={pathname} />
  </div>
</header>
