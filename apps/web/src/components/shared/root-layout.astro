---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import type { Locale } from "@lanjut/i18n/routing";
import { getTranslator } from "@lanjut/i18n/translator";
import { A, F } from "@mobily/ts-belt";
import { SEO } from "astro-seo";
import {
  absoluteUrl,
  alternatesOf,
  defaultAlternateOf,
  publicPath,
} from "@/lib/seo";
import { SITE } from "@/lib/site";
import preferencesScript from "@/scripts/preferences.js?raw";

interface Props {
  locale: Locale;
  /** The page title. Without one, the page uses the site title alone. */
  title?: string;
  description?: string;
  /** Platform pages render each visitor's own data; nothing there to index. */
  noindex?: boolean;
  /** A page with its own tokens in globals.css, set on the body so popups share them. */
  world?: "readers";
}

const props = Astro.props;
const t = getTranslator(props.locale, "meta");

const OG_LOCALE: Record<Locale, string> = { en: "en_US", id: "id_ID" };
const OTHER_LOCALE: Record<Locale, Locale> = { en: "id", id: "en" };

const siteTitle = t("title");
const title = props.title ? `${props.title} · ${SITE.name}` : siteTitle;
const description = props.description ?? t("description");
const path = publicPath(Astro.url.pathname);
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl(`/og/${props.locale}.png`);
const indexable = !props.noindex;
const languageAlternates = F.toMutable(
  A.append(
    A.map(alternatesOf(path), (alternate) => ({
      hrefLang: alternate.hreflang,
      href: alternate.href,
    })),
    { hrefLang: "x-default", href: defaultAlternateOf(path) },
  ),
);
const keywords = A.join(
  [
    "resume builder",
    "ATS resume",
    "applicant tracking system",
    "CV builder",
    "free resume builder",
    "open source",
    "local-first",
  ],
  ", ",
);
---

<!doctype html>
<html lang={props.locale} class="h-full antialiased font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* astro-seo writes the search and share tags. The canonical is always
        passed: its own default comes from Astro.url, which names the .html
        file that the asset server redirects. */}
    <SEO
      title={title}
      description={description}
      canonical={indexable ? canonical : null}
      noindex={props.noindex}
      nofollow={props.noindex}
      languageAlternates={indexable ? languageAlternates : undefined}
      openGraph={{
        basic: { title, type: "website", image: ogImage, url: canonical },
        optional: {
          siteName: SITE.name,
          description,
          locale: OG_LOCALE[props.locale],
          localeAlternate: [OG_LOCALE[OTHER_LOCALE[props.locale]]],
        },
        image: { width: 1200, height: 630, alt: siteTitle },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: ogImage,
        imageAlt: siteTitle,
      }}
      extend={{
        meta: [
          { name: "application-name", content: SITE.name },
          { name: "keywords", content: keywords },
          { name: "author", content: "Rizki Citra" },
          { name: "creator", content: "Rizki Citra" },
        ],
        link: [{ rel: "author", href: "https://rimzzlabs.com" }],
      }}
    />
    <meta name="theme-color" content="#1c6b4f" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192x192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-geist-sans" />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-brand" />
    <Font cssVariable="--font-display" />
    <script is:inline set:html={preferencesScript} />
    <slot name="head" />
  </head>
  <body data-world={props.world}>
    <slot />
  </body>
</html>
